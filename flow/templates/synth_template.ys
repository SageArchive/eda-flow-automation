# Auto-generated by orchestrator/run_flow.py — do not edit by hand.
# Yosys synthesis script for variant: {{ variant_name }}

read_verilog {{ rtl_path }}

# Apply variant-specific parameter overrides BEFORE hierarchy expansion, so
# that generate blocks gated on these parameters (e.g. the PCPI multiplier/
# divider submodules) are correctly included or excluded from the design.
{% for name, value in params.items() %}
chparam -set {{ name }} {{ value }} {{ top_module }}
{% endfor %}

hierarchy -top {{ top_module }}

# Generic synthesis flow (technology-independent, ABC generic gate mapping)
synth -top {{ top_module }}
opt_clean
abc -g cmos2

# Reports consumed by orchestrator/qor_parser.py
tee -o {{ report_path }} stat -width
